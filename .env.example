# =====================================================================
# Recruitment & Outreach Automation System - Environment Configuration
# =====================================================================

# LLM Providers (Chain: Gemini -> Groq -> OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_PROVIDER_CHAIN=gemini,groq,openrouter

# Gmail SMTP & IMAP Credentials
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Email Distribution & Addresses
OPERATOR_EMAIL=operator@example.com
TEAM_LEAD_EMAIL=teamlead@example.com
ADMIN_BCC_EMAIL=admin@example.com

# Outreach Limits & Safety
# TEST_MODE=true redirects all recruiter emails to OPERATOR_EMAIL with a safe header
TEST_MODE=true
GLOBAL_DAILY_LIMIT=50
INTER_EMAIL_DELAY_SEC=3

# Follow-up and IMAP Sync Settings
FOLLOWUP_DAYS=7
IMAP_SYNC_DAYS=30

# File Paths (optional overrides)
RECRUITERS_CSV_PATH=recruiters.csv
EMAIL_HISTORY_CSV_PATH=email_sent_history.csv
SUPPRESSION_LIST_CSV_PATH=suppression_list.csv
SESSION_JSON_PATH=session.json
